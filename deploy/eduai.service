[Unit]
Description=EduAI 智学AI教育 后端服务
# 依赖网络与数据库/Redis 就绪（单机部署时；云库/云Redis 可删掉 mysql.service/redis.service）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 建议用非 root 用户运行；需先 useradd -r -s /sbin/nologin eduai
User=eduai
Group=eduai
WorkingDirectory=/opt/eduai

# 凭据统一从环境文件读取（权限 600，勿提交真实值）
EnvironmentFile=/etc/eduai/eduai.env

# 内存按机器实际调整（500 并发学生参考 512m~1024m）
ExecStart=/usr/bin/java -Xms512m -Xmx1024m -jar /opt/eduai/eduai-system-1.0.0-SNAPSHOT.jar
SuccessExitStatus=143
Restart=always
RestartSec=5

# 日志落盘（配合 journalctl 排查）
StandardOutput=append:/opt/eduai/logs/eduai.log
StandardError=append:/opt/eduai/logs/eduai.err.log

# 安全加固（按需保留）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
