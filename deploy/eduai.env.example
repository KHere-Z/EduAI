# ============================================================
# EduAI 生产环境变量模板
# 复制为 /etc/eduai/eduai.env 并填真实值，权限 chmod 600
# 切勿把真实密钥提交进仓库（此文件仅为占位模板）
# ============================================================

# 激活生产 profile（必填）
SPRING_PROFILES_ACTIVE=prod

# ---- 数据库（云 MySQL）----
DB_URL=jdbc:mysql://<云库地址>:3306/eduai?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=<云库账号>
DB_PASSWORD=<云库密码>

# ---- Redis（云 Redis）----
REDIS_HOST=<云Redis地址>
REDIS_PORT=6379
REDIS_PASSWORD=<云Redis密码>   # 无密码可整行删除或留空

# ---- 上传目录（云服务器绝对路径，确保可写）----
UPLOAD_DIR=/opt/eduai/uploads

# ---- AI 密钥 ----
DEEPSEEK_API_KEY=<sk-xxx>
DOUBAO_API_KEY=<xxx>

# ---- 短信（腾讯云，未接真实短信可留空走 Mock）----
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_TEMPLATE_ID=

# ---- 支付（暂用 mock；接真实渠道时改 alipay/wechat 并填对应凭证）----
PAYMENT_CHANNEL=mock
