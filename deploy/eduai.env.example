# ============================================================
# EduAI 生产环境变量模板
# 复制为 /etc/eduai/eduai.env 并填真实值，权限 chmod 600
# 切勿把真实密钥提交进仓库（此文件仅为占位模板）
# ============================================================

# 激活生产 profile（必填）
SPRING_PROFILES_ACTIVE=prod

# ---- 数据库（同机 MySQL；将来迁云库时把 localhost 换成云库地址）----
DB_URL=jdbc:mysql://localhost:3306/eduai?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=<你给 MySQL 设的密码>

# ---- Redis（同机 Redis；将来迁云 Redis 时改地址）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<你给 Redis 设的密码>   # 无密码可整行删除或留空

# ---- 上传目录（云服务器绝对路径，确保可写）----
UPLOAD_DIR=/opt/eduai/uploads

# ---- AI 密钥 ----
DEEPSEEK_API_KEY=<sk-xxx>
DOUBAO_API_KEY=<xxx>

# ---- 短信（腾讯云，未接真实短信可留空走 Mock）----
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_TEMPLATE_ID=

# ---- 支付（暂用 mock；接真实渠道时改 alipay/wechat 并填对应凭证）----
PAYMENT_CHANNEL=mock
# 微信支付（channel=wechat 时必填；Native 扫码，公钥验签模式）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PUBLIC_KEY_PATH=
WECHAT_PUBLIC_KEY_ID=
WECHAT_NOTIFY_URL=
# 支付宝（channel=alipay 时必填；电脑网站支付，证书模式）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
